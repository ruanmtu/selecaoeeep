Options -Indexes
DirectoryIndex index.php
# arquivos internos nunca são servidos
RedirectMatch 404 ^/includes(/|$)
<FilesMatch "\.(sql|md|txt|log|ini|sh|bak|json)$">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow"
    # scripts e estilos: o navegador sempre confere se há versão nova (evita misturar arquivo novo com antigo)
    <FilesMatch "\.(js|mjs|css)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
# Força HTTPS: ative quando o certificado SSL do subdomínio estiver ativo na Hostinger
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteCond %{HTTP_HOST} ^selecao\. [NC]
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
